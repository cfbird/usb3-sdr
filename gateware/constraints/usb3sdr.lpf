IOBUF PORT "adc_d[4]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[5]" SITE "E2";
IOBUF PORT "adc_d[5]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[6]" SITE "E1";
IOBUF PORT "adc_d[6]" IO_TYPE=LVCMOS18;
