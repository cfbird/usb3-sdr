# usb3-sdr Rev A, LFE5U-25F/45F-6BG256C. Balls from notes/pinplan_power.md (prjtrellis-db CABGA256).
# FT601 and ADC bus balls follow the FT601 / AD9649 pin order (AGY pin-swap 2026-10-24, notes/pinswap/): 0 crossings
# apart from ft_clk; verified by notes/pinswap/claude_verify.py and nextpnr.
SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=ENABLE;
FREQUENCY PORT "adc_dco" 80 MHZ;
FREQUENCY PORT "ft_clk" 100 MHZ;

LOCATE COMP "adc_d[0]" SITE "G4";
IOBUF PORT "adc_d[0]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[1]" SITE "H3";
IOBUF PORT "adc_d[1]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[2]" SITE "F4";
IOBUF PORT "adc_d[2]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[3]" SITE "J3";
IOBUF PORT "adc_d[3]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[4]" SITE "J2";
IOBUF PORT "adc_d[4]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[5]" SITE "H4";
IOBUF PORT "adc_d[5]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[6]" SITE "F1";
IOBUF PORT "adc_d[6]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[7]" SITE "K3";
IOBUF PORT "adc_d[7]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[8]" SITE "G1";
IOBUF PORT "adc_d[8]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[9]" SITE "G5";
IOBUF PORT "adc_d[9]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[10]" SITE "J4";
IOBUF PORT "adc_d[10]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[11]" SITE "F5";
IOBUF PORT "adc_d[11]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[12]" SITE "H5";
IOBUF PORT "adc_d[12]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[13]" SITE "J5";
IOBUF PORT "adc_d[13]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_dco" SITE "J1";
IOBUF PORT "adc_dco" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_or" SITE "K2";
IOBUF PORT "adc_or" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_sclk" SITE "G3";
IOBUF PORT "adc_sclk" IO_TYPE=LVCMOS18;
