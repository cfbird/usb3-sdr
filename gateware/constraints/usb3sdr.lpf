# usb3-sdr Rev A, LFE5U-25F/45F-6BG256C. Balls from notes/pinplan_power.md (prjtrellis-db CABGA256).
# FT601 data/control balls are a provisional pool assignment: reorder at layout to follow the FT601 QFN pin order.
SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=ENABLE;
FREQUENCY PORT "adc_dco" 80 MHZ;
FREQUENCY PORT "ft_clk" 100 MHZ;

LOCATE COMP "adc_d[0]" SITE "B1";
IOBUF PORT "adc_d[0]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[1]" SITE "B2";
IOBUF PORT "adc_d[1]" IO_TYPE=LVCMOS18;
LOCATE COMP "adc_d[2]" SITE "C1";
IOBUF PORT "adc_d[2]" IO_TYPE=LVCMOS18;
